# Public build-time settings for the mobile app. Copy to .env (git-ignored) and fill in.
# EXPO_PUBLIC_* values are embedded in the app bundle: never put secrets here.

# The backend API. On a physical phone, "localhost" is the phone itself, so use your
# computer's LAN address for local development (e.g. http://192.168.1.20:8000/api/v1)
# or your deployed API (https://<service>.onrender.com/api/v1).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# The website; email links (verify email, reset password) open there.
EXPO_PUBLIC_WEB_URL=https://job-search-tracker-blond.vercel.app

# Google OAuth client IDs of type "iOS" and "Android" (not the web client).
# Leave empty to hide "Continue with Google". The backend must also list both in
# GOOGLE_EXTRA_CLIENT_IDS so it accepts tokens issued to them.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
