# Copy to apps/backend/.env and adjust. Never commit real secrets.
APP_NAME="Career Command Center"
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/career_command_center
# Browser origins allowed to call the API with cookies (JSON list, no trailing slashes).
CORS_ORIGINS=["http://localhost:5173"]

# Timezone that defines "today" and working days for follow-up due dates.
TIMEZONE=Asia/Kolkata
# Auto-rules: follow-up due N working days after entering applied/screening;
# suggest 'ghosted' after N days with no contact.
FOLLOWUP_WORKING_DAYS=2
GHOST_AFTER_DAYS=21

# Optional. Tests use "<database>_test" on the same server unless this is set.
# The test database is dropped and rebuilt on every run: never point it at real data.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/career_command_center_test

# ============================ Authentication ============================
# Public URL of the React app. Email links (verify, reset) point here. In production it must be
# https:// and must be listed in CORS_ORIGINS (it is allowed automatically for sign-in requests).
FRONTEND_URL=http://localhost:5173

# REQUIRED unless FRONTEND_URL is localhost (the app refuses to start without it). 32+ random
# characters. Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it only invalidates CSRF tokens (the page fetches a new one); sessions stay valid.
SECRET_KEY=

# Session cookie. Leave COOKIE_SECURE unset: it is on automatically unless FRONTEND_URL is localhost.
COOKIE_NAME=session
# COOKIE_SECURE=true
# lax (default) works when the app and API share a site (or you use the proxy in the README).
# Use none ONLY for a cross-site setup; Safari and some browsers block third-party cookies.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Google Sign-In (optional). The client ID is public; no client secret is needed for this flow.
# Create a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials,
# add your frontend origin(s) under "Authorized JavaScript origins", and set the same ID in the
# frontend as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# SendGrid (optional locally; required to send verification and reset emails in production).
# The sender address must be verified in SendGrid (Single Sender or domain authentication).
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME="Career Command Center"
# EMAIL_REPLY_TO=

# Local development only (refused when FRONTEND_URL is not localhost): skip the verification email.
# AUTO_VERIFY_EMAIL=true

# Data that existed before accounts was given to this email's account once it is verified.
# SET THIS IN PRODUCTION: on a deployed site nothing is claimed while it is empty.
LEGACY_DATA_OWNER_EMAIL=

# Number of reverse proxies in front of the API (Render, Fly, nginx, ...). 0 = use the socket IP.
# With 1, the client IP is the last X-Forwarded-For entry. Needed for per-IP rate limits to work.
TRUSTED_PROXY_COUNT=0

# Native app Google OAuth client IDs (iOS and Android), comma-separated. Optional.
GOOGLE_EXTRA_CLIENT_IDS=

# ============================ AI assistant ============================
# Free-tier LLM providers. With neither key set, the assistant is disabled (its endpoints 503).
# Groq keys: https://console.groq.com/keys   Google AI Studio keys: https://aistudio.google.com/apikey
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
# Per-model budgets as JSON, matching the limits each provider's console shows for YOUR account.
# Fields: rpm, rpd, tpm, tpd (0 = not enforced locally), max_prompt_tokens, max_completion_tokens.
# Models not listed keep the defaults in app/llm/catalog.py; a new model also needs "provider".
# LLM_MODEL_LIMITS={"openai/gpt-oss-120b": {"rpm": 30, "rpd": 1000, "tpm": 12000, "tpd": 100000}}
# Task -> ordered model list, replacing the built-in routing policy for that task (app/llm/policy.py).
# LLM_POLICY_OVERRIDE={"chat.agent": ["openai/gpt-oss-120b", "gemini-3.5-flash-lite"]}
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_RUN_TIMEOUT_SECONDS=90
LLM_MAX_MODEL_SWITCHES=3
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
# Per-user assistant limits.
CHAT_DAILY_MESSAGES=60
CHAT_PER_MINUTE=6
CHAT_MAX_CONVERSATIONS=50
# Changes proposed by the assistant always need a confirmation; this disables proposing at all.
CHAT_WRITES_ENABLED=true
CHAT_ACTION_TTL_MINUTES=15
CHAT_HEARTBEAT_SECONDS=10
CHAT_TOOL_TIMEOUT_SECONDS=8
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
# Optional LangSmith tracing, read by LangChain itself. It sends prompts (including redacted
# resume text) to LangSmith, so it is off unless you turn it on.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=career-command-center
