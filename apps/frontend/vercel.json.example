{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_comment": "Optional. Rename to vercel.json and replace YOUR-API-HOST. Proxies /api/* to the backend so the browser only ever talks to your Vercel domain, which keeps the session cookie first-party (Safari and other privacy-focused browsers block third-party cookies). Then set VITE_API_BASE_URL=/api/v1 in Vercel, and FRONTEND_URL to your Vercel URL on the backend.",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-API-HOST/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
