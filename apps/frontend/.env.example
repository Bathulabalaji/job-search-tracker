# Copy to apps/frontend/.env. Only VITE_-prefixed vars reach the browser; never put secrets here.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public Google OAuth client ID (the same one as the backend GOOGLE_CLIENT_ID). Leave empty to
# hide the "Continue with Google" buttons.
VITE_GOOGLE_CLIENT_ID=

# Optional links shown next to the "I agree to the terms" checkbox.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
