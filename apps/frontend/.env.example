# Copy to apps/frontend/.env. Only VITE_-prefixed vars reach the browser; never put secrets here.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public Google OAuth client ID (the same one as the backend GOOGLE_CLIENT_ID). Leave empty to
# hide the "Continue with Google" buttons.
VITE_GOOGLE_CLIENT_ID=

# Optional links shown next to the "I agree to the terms" checkbox.
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Shown on the public /contact page. Everything is public, and empty values are hidden.
# Email and GitHub have defaults in src/lib/env.ts; set them here (and in Vercel) to change.
VITE_CONTACT_NAME=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CONTACT_LINKEDIN_URL=
VITE_CONTACT_GITHUB_URL=

# Copy to apps/frontend/.env. Only VITE_-prefixed vars reach the browser; never put secrets here.
